// NYX Automate — schema (Image-Studio pivot).
//
// PLACEHOLDER / minimal. The old SaaS schema (subscriptions, tiers, feature
// gates, scripts, videos, audit logs) lives in `prisma/schema.legacy.prisma`
// for reference — re-introduce models from there as features come back.
//
// Datasource points at a NEW Supabase Postgres that has NOT been provisioned
// yet — DATABASE_URL / DIRECT_URL in .env are placeholders. Auth is currently
// database-FREE (Google + allowlist, JWT — see src/lib/auth.ts), so the app
// runs without a live DB. Wire the DB when these models are actually used.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── NextAuth models (used once the Prisma adapter is re-enabled) ──────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // "user" | "admin"

  // Parked voice/avatar feature still reads these.
  avatarUrl    String?
  avatarConfig Json?

  accounts Account[]
  sessions Session[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  generations Generation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Image Studio (starter; expand as generation lands) ────────────────────

model Generation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model     String // "gpt-image-1" | "gemini-image" | "flux" | …
  prompt    String
  aspect    String?
  imageUrl  String?
  status    String   @default("pending") // pending | completed | failed
  createdAt DateTime @default(now())
}
