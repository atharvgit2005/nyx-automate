// NYX Automate — schema (Image-Studio pivot).
//
// PLACEHOLDER / minimal. The old SaaS schema (subscriptions, tiers, feature
// gates, scripts, videos, audit logs) lives in `prisma/schema.legacy.prisma`
// for reference — re-introduce models from there as features come back.
//
// Datasource points at a NEW Supabase Postgres that has NOT been provisioned
// yet — DATABASE_URL / DIRECT_URL in .env are placeholders. Auth is currently
// database-FREE (Google + allowlist, JWT — see src/lib/auth.ts), so the app
// runs without a live DB. Wire the DB when these models are actually used.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── NextAuth models (used once the Prisma adapter is re-enabled) ──────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // "user" | "admin"

  // Parked voice/avatar feature still reads these.
  avatarUrl    String?
  avatarConfig Json?

  accounts Account[]
  sessions Session[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  generations Generation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Image Studio (starter; expand as generation lands) ────────────────────

model Generation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model     String // "gpt-image-1" | "gemini-image" | "flux" | …
  prompt    String
  aspect    String?
  imageUrl  String?
  status    String   @default("pending") // pending | completed | failed
  createdAt DateTime @default(now())
}

// ── Lead pipeline (sources → scoring → verification → portal) ─────────────

model ScrapeQuery {
  id        String      @id @default(cuid())
  text      String
  region    String? // ISO country/region code
  sources   String[] // "csv" | "google_places"
  filters   Json?
  enabled   Boolean     @default(true)
  brandId   String? // TODO: scope when workspaces exist
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  runs      ScrapeRun[]
  leads     Lead[]
}

model ScrapeRun {
  id         String      @id @default(cuid())
  queryId    String
  query      ScrapeQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  status     String      @default("queued") // queued | running | done | failed
  leadCount  Int         @default(0)
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime    @default(now())
}

model Lead {
  id           String       @id @default(cuid())
  source       String // "csv" | "google_places"
  sourceId     String
  name         String
  website      String?
  email        String?
  phone        String?
  contactName  String?
  contactTitle String?
  instagram    String?
  category     String?
  address      String?
  score        Int          @default(0)
  signals      String[]
  status       String       @default("new") // new | verified | contacted | replied | won | dead
  temperature  String? // hot | warm | cold
  emailValid   Boolean?
  // Client-finder / outreach (assessProspect)
  igHandle     String?
  igFollowers  String? // formatted e.g. "15.2k"
  igPostCount  Int          @default(0)
  opportunity  Int          @default(0) // 1-100, higher = weaker presence = better prospect
  weaknesses   String?
  pitch        String?
  brandId      String? // TODO: scope when workspaces exist
  queryId      String?
  query        ScrapeQuery? @relation(fields: [queryId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([source, sourceId])
  @@index([score])
  @@index([status])
}

// ── AI Chat Orchestration (Higgsfield-Style Context & Reference Lock) ─────

model OrchestratorSession {
  id           String                  @id @default(cuid())
  name         String
  systemPrompt String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  messages     OrchestratorMessage[]
  references   OrchestratorReference[]
}

model OrchestratorMessage {
  id        String              @id @default(cuid())
  sessionId String
  session   OrchestratorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String              // "user" | "assistant"
  content   String
  createdAt DateTime            @default(now())
}

model OrchestratorReference {
  id        String              @id @default(cuid())
  sessionId String
  session   OrchestratorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  content   String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
}
