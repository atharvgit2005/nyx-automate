    {
      "parameters": {
        "jsCode": "// Split Active Instagram inputs into hashtags vs profiles; carry post count.\nconst hashtags = [];\nconst profiles = [];\nfor (const item of items) {\n  const type = String(item.json.Type || '');\n  const value = item.json['Hashtag/ Username'] || item.json['Hashtag/Username'] || '';\n  if (!value) continue;\n  if (type.includes('Profile')) profiles.push(value);\n  else if (type.includes('Hashtag')) hashtags.push(String(value).replace(/^#/, ''));\n}\nconst rec = $('Get Automation Record').first().json;\nconst numPosts = Number(rec['Quantity to Scrape']) || 12;\nreturn [{ json: { hashtags, profiles, numPosts } }];"
      },
      "id": "format-inputs",
      "name": "Format Inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:2005/api/scrape/instagram",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'discover', hashtags: $json.hashtags, profiles: $json.profiles, limit: $json.numPosts }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "discover",
      "name": "App: Discover posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "A2qInC7YaPq9T3H2",
          "name": "NYX engine token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// The /api/scrape/instagram discover call returns { posts: [...] }.\n// Split into one item per post for the rest of the pipeline.\nconst posts = $json.posts || [];\nreturn posts.map((p) => ({ json: p }));"
      },
      "id": "split-posts",
      "name": "Split posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
