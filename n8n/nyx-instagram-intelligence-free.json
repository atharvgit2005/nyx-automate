          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.url }}",
              "rightValue": "^https://www\\.instagram\\.com/(p|reel)/[^/]+/?$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "filter-posts",
      "name": "Filter valid posts",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        1600,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:2005/api/scrape/instagram",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'comments', url: $json.url, limit: 15 }) }}",
        "options": {
