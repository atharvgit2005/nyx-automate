    },
    {
      "parameters": {
        "jsCode": "// Loop over ALL items (httpRequest ran 1:1 per filtered post, so index pairs).\nconst comments = $input.all();\nconst posts = $('Filter valid posts').all();\nreturn comments.map((c, i) => ({ json: { ...(posts[i] ? posts[i].json : {}),\n  concatenated_text: c.json.concatenated_text || '',\n  comments_scraped: (c.json.comments || []).length } }));"
      },
