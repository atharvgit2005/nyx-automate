    {
      "parameters": {
        "jsCode": "// Loop over ALL items; sentiment ran 1:1 per Attach-comments item.\nconst sent = $input.all();\nconst posts = $('Attach comments').all();\nreturn sent.map((s, i) => ({ json: { ...(posts[i] ? posts[i].json : {}), sentiment: {\n  overall_sentiment: s.json.overall_sentiment ?? null,\n  tool_usefulness: s.json.tool_usefulness ?? null,\n  common_questions: Array.isArray(s.json.common_questions) ? s.json.common_questions : [],\n  key_insights: s.json.key_insights || '' } } }));"
      },
