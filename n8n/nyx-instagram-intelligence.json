    {
      "parameters": {
        "jsCode": "// Collect the post URLs into a single array for the comment scraper.\nconst postURLs = [];\nfor (const item of items) {\n  if (item.json.url) postURLs.push(item.json.url);\n}\nreturn [{ json: { postURLs } }];"
      },
      "id": "collect-urls",
      "name": "Collect post URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apify~instagram-comment-scraper/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ directUrls: $json.postURLs, includeNestedComments: false, resultsLimit: 15 }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "scrape-comments",
      "name": "Apify: Comment Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2060,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Join comments back onto their post by matching the comment's `postUrl`\n// (verified 2026: the comment scraper output key is lowercase `postUrl`, NOT\n// `postURL`). This replaces the old Summarize-by-postURL step, which both used the\n// wrong key and relied on index-pairing that didn't line up with the post records.\nconst comments = $input.all().map(i => i.json);\nconst posts = $('Filter valid posts').all().map(i => i.json);\nconst byUrl = {};\nfor (const c of comments) {\n  const u = c.postUrl || c.postURL;\n  const t = (c.text || '').trim();\n  if (!u || !t) continue;\n  (byUrl[u] = byUrl[u] || []).push(t);\n}\nconst out = [];\nfor (const p of posts) {\n  const texts = byUrl[p.url] || [];\n  out.push({ json: { ...p, concatenated_text: texts.join('\\n'), comment_count_scraped: texts.length } });\n}\nreturn out;"
      },
      "id": "assemble",
      "name": "Assemble post + comments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2280,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-5.1-mini', messages: [ { role: 'system', content: 'You are an audience-intelligence analyst. Read the Instagram comments for one post and return ONLY JSON with: overall_sentiment (integer 1-5), tool_usefulness (integer 1-5, how useful commenters find the tool/topic), common_questions (array of distinct questions asked), key_insights (one-paragraph string).' }, { role: 'user', content: 'Here are the aggregated comments for a single Instagram post:\\n' + ($json.concatenated_text || '(no comments)') + '\\n\\nCaption for context: ' + ($json.caption || '') } ], response_format: { type: 'json_object' } }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "sentiment",
      "name": "Sentiment Analysis (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2500,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Loop over ALL items; sentiment ran 1:1 per Assemble item.\nconst sent = $input.all();\nconst posts = $('Assemble post + comments').all();\nreturn sent.map((s, i) => { const raw = s.json?.choices?.[0]?.message?.content || '{}';\n  let v = {}; try { v = JSON.parse(raw); } catch (e) { v = {}; }\n  return { json: { ...(posts[i] ? posts[i].json : {}), sentiment: {\n    overall_sentiment: v.overall_sentiment ?? null,\n    tool_usefulness: v.tool_usefulness ?? null,\n    common_questions: Array.isArray(v.common_questions) ? v.common_questions : [],\n    key_insights: v.key_insights || '' } } };\n});"
      },
      "id": "merge-sentiment",
      "name": "Attach sentiment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2720,
        200
      ]
    },
