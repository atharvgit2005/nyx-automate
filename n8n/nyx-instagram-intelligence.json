    {
      "parameters": {
        "jsCode": "// Split the Active Instagram inputs into hashtags vs profiles, and carry through\n// how many posts to scrape (from the Automation record's `Quantity to Scrape`).\n// NOTE: the original spec referenced `numPosts` in the scraper bodies but never\n// produced it here \u2014 that was a dead reference. We resolve it from the trigger record.\nconst hashtags = [];\nconst profiles = [];\nfor (const item of items) {\n  const type = String(item.json.Type || '');\n  const value = item.json['Hashtag/ Username'] || item.json['Hashtag/Username'] || '';\n  if (!value) continue;\n  if (type.includes('Profile')) profiles.push(value);\n  else if (type.includes('Hashtag')) hashtags.push(String(value).replace(/^#/, ''));\n}\nconst rec = $('Get Automation Record').first().json;\nconst numPosts = Number(rec['Quantity to Scrape']) || 12;\nreturn [{ json: { hashtags, profiles, numPosts } }];"
      },
      "id": "format-inputs",
      "name": "Format Inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apify~instagram-hashtag-scraper/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ hashtags: $json.hashtags, resultsType: 'posts', resultsLimit: $json.numPosts }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "scrape-hashtags",
      "name": "Apify: Hashtag Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        120
      ]
    },
    {
